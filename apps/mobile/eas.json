{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AXIOS_BASE_URL": "https://explora-ocana-backend.vercel.app/"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_AXIOS_BASE_URL": "https://explora-ocana-backend.vercel.app/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
